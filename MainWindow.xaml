<Window x:Class="InDesignBookStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="InDesign Book Studio" Width="1440" Height="900" Background="#1E1E1E" WindowStartupLocation="CenterScreen">
<Window.InputBindings>
<KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding NewPageCommand}"/>
</Window.InputBindings>
<DockPanel>
<Menu DockPanel.Dock="Top" Background="#252526" Foreground="White">
<MenuItem Header="_File"><MenuItem Header="New Page" Command="{Binding NewPageCommand}"/><Separator/><MenuItem Header="Open..." Command="{Binding OpenCommand}"/><MenuItem Header="Save" Command="{Binding SaveCommand}"/><MenuItem Header="Save As..." Command="{Binding SaveAsCommand}"/><Separator/><MenuItem Header="Exit" Click="Exit_Click"/></MenuItem>
<MenuItem Header="_Book"><MenuItem Header="Add Page" Command="{Binding NewPageCommand}"/><MenuItem Header="Delete Page" Command="{Binding DeletePageCommand}"/></MenuItem>
</Menu>
<ToolBar DockPanel.Dock="Top" Background="#333333" Foreground="White">
<Button Content="New Page" Command="{Binding NewPageCommand}"/><Button Content="Delete" Command="{Binding DeletePageCommand}"/><Separator/>
<TextBlock Text="Font:" VerticalAlignment="Center" Margin="8,0,2,0"/><ComboBox Width="130" ItemsSource="{Binding Fonts}" SelectedItem="{Binding CurrentFont, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Size:" VerticalAlignment="Center" Margin="8,0,2,0"/><ComboBox Width="65" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding CurrentFontSize}"/>
<Button Content="B" FontWeight="Bold" Command="{Binding BoldCommand}"/><Button Content="I" FontStyle="Italic" Command="{Binding ItalicCommand}"/><Separator/>
<Button Content="Left" Command="{Binding AlignLeftCommand}"/><Button Content="Center" Command="{Binding AlignCenterCommand}"/><Button Content="Right" Command="{Binding AlignRightCommand}"/><Separator/>
<TextBlock Text="Zoom" VerticalAlignment="Center" Margin="10,0,4,0"/><Slider Width="130" Minimum="50" Maximum="180" Value="{Binding Zoom, Mode=TwoWay}"/><TextBlock Text="{Binding Zoom, StringFormat={}{0:0}%}" Width="45" VerticalAlignment="Center"/>
</ToolBar>
<StatusBar DockPanel.Dock="Bottom" Background="#252526" Foreground="White"><StatusBarItem Content="{Binding StatusText}"/><Separator/><StatusBarItem Content="{Binding PageInfo}"/></StatusBar>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,1,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PAGES" Foreground="#CCCCCC" FontWeight="Bold" Margin="14"/>
<ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="#252526" BorderThickness="0" Foreground="White">
<ListBox.ItemTemplate><DataTemplate><Border Margin="8" Padding="8" Background="#333333" CornerRadius="3"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" Height="35" Foreground="#AAAAAA" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
</ListBox></DockPanel></Border>
<ScrollViewer Grid.Column="1" Background="#3A3A3A" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid Margin="60">
<Border Width="{Binding PageWidth}" Height="{Binding PageHeight}" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
<Border.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/></Border.LayoutTransform>
<Grid Margin="55"><RichTextBox x:Name="Editor" BorderThickness="0" Background="Transparent" FontFamily="{Binding CurrentFont}" FontSize="{Binding CurrentFontSize}" FontWeight="{Binding CurrentFontWeight}" FontStyle="{Binding CurrentFontStyle}" AcceptsTab="True" VerticalScrollBarVisibility="Hidden" TextChanged="Editor_TextChanged"/></Grid>
</Border></Grid></ScrollViewer>
<Border Grid.Column="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0" Padding="14"><ScrollViewer><StackPanel>
<TextBlock Text="BOOK" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="Title" Foreground="#AAAAAA" Margin="0,18,0,4"/><TextBox Text="{Binding Book.Title, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Author" Foreground="#AAAAAA" Margin="0,12,0,4"/><TextBox Text="{Binding Book.Author, UpdateSourceTrigger=PropertyChanged}"/><Separator Margin="0,20"/>
<TextBlock Text="PAGE" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="Page name" Foreground="#AAAAAA" Margin="0,18,0,4"/><TextBox Text="{Binding SelectedPage.Name, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Page size" Foreground="#AAAAAA" Margin="0,12,0,4"/><TextBlock Text="{Binding PageSizeText}" Foreground="White"/><Separator Margin="0,20"/>
<TextBlock Text="LAYOUT" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="Tip" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,12,0,0" Text="Write directly on the page. Use the toolbar for typography and alignment. Pages are stored in the project file."/>
</StackPanel></ScrollViewer></Border>
</Grid></DockPanel></Window>
